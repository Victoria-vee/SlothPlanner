# Copy this file to .env and fill in your own values. Never commit .env.
# Get the connection string from MongoDB Atlas: Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=sloth_planner

# Optional: use if you see "querySrv ECONNREFUSED" (your local DNS blocks SRV lookups)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional (defaults to 3000; Render sets this automatically)
# PORT=3000

# Browser origin(s) allowed to call this API, comma separated, no trailing slash.
# Defaults to http://localhost:5173. In production set it to your deployed frontend URL.
# CORS_ORIGIN=https://your-frontend.onrender.com

# Ollama Cloud (required for POST /api/brain-dump). Keep these on the server only.
# Create a key at https://ollama.com/settings/keys and pick a model name from https://ollama.com/api/tags
OLLAMA_API_KEY=<your-ollama-api-key>
OLLAMA_MODEL=<cloud-model-name>
# Optional:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_TIMEOUT_MS=60000
